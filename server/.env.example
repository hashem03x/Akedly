# ─────────────────────────────────────────────────────────────
# Core (used starting Phase 1)
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string. If unset, the server still starts
# (health endpoint reports database: "disconnected"); nothing else
# in Phase 1 depends on it.
MONGODB_URI=

# Origin allowed to call this API with credentials (the marketing
# site / future dashboard). Defaults to http://localhost:3411 if unset.
FRONTEND_URL=http://localhost:3411

# This server's own public HTTPS base URL (an ngrok URL in dev). Used to
# build callback URLs that outside providers (currently Twilio) need to
# reach — e.g. https://abcd1234.ngrok.app
PUBLIC_APP_URL=

# ─────────────────────────────────────────────────────────────
# Auth (Phase 2)
# ─────────────────────────────────────────────────────────────
# Secret used to sign/verify JWTs. Required in production (the server
# refuses to start without it there); in development, if left unset,
# the server generates a random one at startup for that process only
# (sessions won't survive a restart). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ─────────────────────────────────────────────────────────────
# Shopify
# ─────────────────────────────────────────────────────────────
# Create a Partner app at partners.shopify.com to get these.
SHOPIFY_CLIENT_ID=
SHOPIFY_API_SECRET=
# Minimum scopes for the MVP — do not widen without a concrete feature
# that needs it (see server/PRD.md §10/§27).
SHOPIFY_SCOPES=read_orders,read_customers
# Public HTTPS URL this server is reachable at (ngrok URL in dev) — used
# to build the OAuth callback and webhook URLs.
SHOPIFY_APP_URL=

# ─────────────────────────────────────────────────────────────
# WhatsApp Cloud API
# ─────────────────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
# Arbitrary string you choose; Meta echoes it back on webhook verification.
WHATSAPP_VERIFY_TOKEN=

# ─────────────────────────────────────────────────────────────
# Voice — Twilio
# ─────────────────────────────────────────────────────────────
VOICE_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─────────────────────────────────────────────────────────────
# Token encryption at rest for stored Shopify/WhatsApp access
# tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────
TOKEN_ENCRYPTION_KEY=
