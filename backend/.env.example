# --- Core ---
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/akedly
JWT_SECRET=
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000

# Public URL of THIS backend. Used to build the Shopify OAuth callback URL and
# the address webhooks are registered against — must be reachable from Shopify/
# WooCommerce/Meta, so in production this is the deployed backend URL, not localhost.
BACKEND_URL=http://localhost:4000

# 32-byte hex key used to encrypt store credentials at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=

# --- Shopify OAuth app ---
# From your app in the Shopify Partner Dashboard. Configure the app's
# "Allowed redirection URL(s)" to: {BACKEND_URL}/api/v1/integrations/shopify/oauth/callback
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Minimum scopes Akedly actually needs: read new orders, and write them back
# (tags) once confirmed/cancelled.
SHOPIFY_SCOPES=read_orders,write_orders
SHOPIFY_API_VERSION=2024-07

# --- WhatsApp ---
# "mock" logs messages instead of sending them - never allowed when NODE_ENV=production.
WHATSAPP_PROVIDER=mock

# Meta WhatsApp Business Platform (Cloud API)
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_VERIFY_TOKEN=
WHATSAPP_META_APP_SECRET=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
