# --- Core ---
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/akedly
JWT_SECRET=
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000

# Public URL of THIS backend. Used to build the Shopify OAuth callback URL and
# the address webhooks are registered against — must be reachable from Shopify/
# WooCommerce/Meta, so in production this is the deployed backend URL, not localhost.
# Required when NODE_ENV=production (the app refuses to boot without it, rather
# than silently building callback URLs that point at localhost).
BACKEND_URL=https://akedly-backend.vercel.app/

# 32-byte hex key used to encrypt store credentials at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=

# --- Shopify OAuth app ---
# From your app in the Shopify Partner Dashboard. Configure the app's
# "Allowed redirection URL(s)" to: {BACKEND_URL}/api/v1/integrations/shopify/oauth/callback
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Minimum scopes Akedly actually needs: read new orders, and write them back
# (tags) once confirmed/cancelled.
SHOPIFY_SCOPES=read_orders,write_orders
SHOPIFY_API_VERSION=2026-07

# --- WhatsApp ---
# "mock" logs messages instead of sending them - never allowed when NODE_ENV=production.
WHATSAPP_PROVIDER=mock

# Meta WhatsApp Business Platform (Cloud API)
# Webhook callback URL to configure in Meta App Dashboard > WhatsApp > Configuration:
#   {BACKEND_URL}/api/v1/webhooks/whatsapp
# WHATSAPP_META_VERIFY_TOKEN is a secret string YOU choose (not issued by Meta) —
# enter the same value in both places. WHATSAPP_META_APP_SECRET is the Meta app's
# secret, used to verify the X-Hub-Signature-256 header on incoming webhook POSTs.
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_VERIFY_TOKEN=
WHATSAPP_META_APP_SECRET=
WHATSAPP_META_API_VERSION=v20.0

# The Meta-approved order-confirmation template's name. Must exactly match
# what's approved in Meta Business Manager (WhatsApp > Message Templates).
# Required because the first message to a customer who hasn't messaged the
# business first cannot be a freeform/interactive message (see
# confirmation.service.ts / whatsapp-meta.provider.ts).
#
# There is deliberately NO env var for this template's language. It is
# hardcoded to the literal "en" in whatsapp-meta.provider.ts
# (CONFIRMATION_TEMPLATE_LANGUAGE) — independently verified against Meta by
# hand — and must never be configurable, locale-detected, or defaulted.
WHATSAPP_CONFIRMATION_TEMPLATE_NAME=akedly_order_confirmation

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
